# Copy to .env (gitignored) and fill in. Read by Expo at bundle time: restart Metro after a change. Never put a token here.

# Gateway URL for devices, e.g. your Tailscale Serve front. Unset: ws://127.0.0.1:18789 (devices use the URL pairing hands back).
EXPO_PUBLIC_OPENCLAW_URL=wss://my-mac.example-tailnet.ts.net

# MagicDNS name of the Mac running ano-pair, tried during pairing discovery. Unset: that candidate is skipped.
EXPO_PUBLIC_ANO_PAIR_HOST=my-mac.example-tailnet.ts.net

# Your first name for the Home greeting and agent prompts. Unset: no name, prompts say "the user".
EXPO_PUBLIC_ANO_USER_NAME=Alex

# OpenClaw agent id new chats and canvases run on. Unset: main.
EXPO_PUBLIC_ANO_DEFAULT_AGENT=main
