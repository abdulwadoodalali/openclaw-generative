# ano-pair settings. Copy to .env (git-ignored); ano-pair.sh loads it and passes every ANO_PAIR_* to launchd.
# Required: this Mac's Tailscale IPv4 (`tailscale ip -4`); the service listens only here and on 127.0.0.1.
ANO_PAIR_TAILNET_IP=100.64.0.10
# Required: comma-separated Tailscale login names allowed to pair (exact match).
ANO_PAIR_ALLOWED_LOGINS=you@example.com
# This Mac's MagicDNS name; also allowed as a Host header. Gateway URL defaults to wss://<this>.
ANO_PAIR_MAGICDNS=my-mac.example-tailnet.ts.net
# Optional: gateway URL handed to the app (required if ANO_PAIR_MAGICDNS is unset).
# ANO_PAIR_GATEWAY_URL=wss://my-mac.example-tailnet.ts.net
# Optional: listen port (default 4391).
# ANO_PAIR_PORT=4391
# Optional: path to the openclaw CLI (default /opt/homebrew/bin/openclaw).
# ANO_PAIR_OPENCLAW_BIN=/opt/homebrew/bin/openclaw
# Optional: path to the Tailscale CLI (default is the macOS app bundle binary).
# ANO_PAIR_TAILSCALE_BIN=/Applications/Tailscale.app/Contents/MacOS/Tailscale
# Optional: node binary used by ano-pair.sh (default /opt/homebrew/bin/node; not passed to the service).
# ANO_PAIR_NODE=/opt/homebrew/bin/node
